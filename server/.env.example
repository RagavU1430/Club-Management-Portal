# AI Frontier Club — .env
# Copy this file to .env and fill in values. None are required for local dev.

# --- Server ---
PORT=4000
CLIENT_URL=http://localhost:5173

# --- Database ---
# Leave empty for an in-process MongoDB (runs everywhere, no install).
# Set to a real connection string (mongodb://... or mongodb+srv://...) for production.
MONGODB_URI=

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# --- Uploads ---
UPLOAD_DIR=uploads
PUBLIC_BASE_URL=http://localhost:4000

# --- Email (required by /api/send-confirmation in production) ---
# Use a Gmail App Password, not the normal Gmail account password.
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_SENDER_NAME=AI Frontier Club
